{
  "schemaVersion": 1,
  "environment": "staging",
  "container": "REPLACE_WITH_PINNED_STAGING_POSTGRES_CONTAINER",
  "writers": {
    "web": "REPLACE_WITH_STAGING_WEB_APPLICATION_UUID",
    "queue": "REPLACE_WITH_STAGING_QUEUE_APPLICATION_UUID",
    "scheduler": "REPLACE_WITH_STAGING_SCHEDULER_APPLICATION_UUID",
    "pulse": "REPLACE_WITH_STAGING_PULSE_APPLICATION_UUID",
